[Version]
Signature="$WINDOWS NT$"
Class=System
ClassGuid={4d36e97d-e325-11ce-bfc1-08002be10318}
Provider=%Provider%
DriverVer=11/14/2026,0.3.0.0
CatalogFile=NxSynaTouch.cat
PnpLockdown=1

[Manufacturer]
%Provider%=Models,NTARM64.10.0...19041

[Models.NTARM64.10.0...19041]
%DeviceDesc%=Install,ACPI\ZTE0001
%DeviceDesc%=InstallPolling,ACPI\ZTE0002

[DestinationDirs]
DriverCopy=13

[SourceDisksNames]
1=%DiskName%,,,

[SourceDisksFiles]
NxSynaTouch.sys=1

[Install.NT]
CopyFiles=DriverCopy

[InstallPolling.NT]
CopyFiles=DriverCopy

[DriverCopy]
NxSynaTouch.sys

[Install.NT.HW]
AddReg=HardwareSettings

[InstallPolling.NT.HW]
AddReg=HardwareSettings,PollingSettings

[HardwareSettings]
HKR,,"LowerFilters",0x00010008,"vhf"

[PollingSettings]
HKR,,"PollingMode",0x00010001,1

[Install.NT.Services]
AddService=NxSynaTouch,0x00000002,DriverService

[InstallPolling.NT.Services]
AddService=NxSynaTouch,0x00000002,DriverService

[DriverService]
DisplayName=%DeviceDesc%
ServiceType=1
StartType=3
ErrorControl=1
ServiceBinary=%13%\NxSynaTouch.sys

[Install.NT.Wdf]
KmdfService=NxSynaTouch,KmdfSettings

[InstallPolling.NT.Wdf]
KmdfService=NxSynaTouch,KmdfSettings

[KmdfSettings]
KmdfLibraryVersion=1.31

[Strings]
Provider="NX809J Port"
DeviceDesc="NX809J Synaptics S3910V Touch"
DiskName="NX809J ARM64 Touch Driver"
